{
  "name": "dsh-redteam",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DSH-native red-team workspace: ARTEX domain workflows with REA evidence providers.",
  "icon": "./icon-small.png",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./client": "./lib/client.js"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "icon-small.png",
    "README.md",
    "vendor"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-resources.mjs && node scripts/build-client.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test test/*.test.mjs",
    "verify:rea-package": "node scripts/verify-rea-package.mjs",
    "package:rea-native": "node scripts/package-rea-native.mjs",
    "prebuild": "node scripts/package-rea-native.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "dsh-better-sidebar"
      ],
      "platform": "web"
    },
    "manifestVersion": 1
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
