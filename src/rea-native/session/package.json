{
  "name": "@dsh-redteam/rea-native-session",
  "version": "6.5.0-dsh.1",
  "private": true,
  "type": "module",
  "description": "REA application services and providers owned by DSH sessions; no REA transport or CLI entrypoint.",
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || ^24.11.0 || >=26.0.0"
  },
  "exports": {
    ".": {
      "types": "./runtime.d.mts",
      "default": "./runtime.mjs"
    },
    "./prompts": {
      "types": "./prompts.d.mts",
      "default": "./upstream/dist/contracts/promptContracts.js"
    },
    "./cli": {
      "types": "./cli/runtime.d.mts",
      "default": "./cli/runtime.mjs"
    },
    "./upstream/*": "./upstream/*"
  },
  "files": [
    "runtime.mjs",
    "runtime.d.mts",
    "native-registrar.mjs",
    "upstream",
    "LICENSE",
    "provenance.json",
    "cli",
    "prompts.d.mts"
  ],
  "dependencies": {
    "@babel/parser": "8.0.4",
    "@babel/types": "8.0.4",
    "@clack/prompts": "1.7.0",
    "@electron/asar": "4.2.0",
    "@jridgewell/trace-mapping": "0.3.31",
    "@lydell/node-pty": "1.1.0",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/server": "2.3.1",
    "@xmldom/xmldom": "0.9.12",
    "@xterm/addon-serialize": "0.14.0",
