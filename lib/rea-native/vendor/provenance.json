{
  "package": "rea-agents",
  "version": "6.5.0",
  "license": "MIT",
  "entry": "import { GoBinaryService } from './dist/application/go/GoBinaryService.js';\nimport { GoBinaryProvider } from './dist/go/GoBinaryProvider.js';\nimport { RustBinaryService } from './dist/application/rust/RustBinaryService.js';\nimport { RustBinaryProvider } from './dist/rust/RustBinaryProvider.js';\nimport { PeResourcesService } from './dist/application/binaryDiagnostics/PeResourcesService.js';\nimport { PeResourcesProvider } from './dist/native/pe/PeResourcesProvider.js';\nimport { ElectronFuseService } from './dist/application/electron/ElectronFuseService.js';\nimport { ElectronFuseProvider } from './dist/electron/ElectronFuseProvider.js';\nimport { z } from 'zod';\nimport { inspectGoBinaryInputSchema } from './dist/domain/go/goBinary.js';\nimport { inspectRustBinaryInputSchema } from './dist/domain/rust/rustBinary.js';\nimport { inspectPeResourcesInputSchema } from './dist/domain/native/peResources.js';\nimport { inspectElectronFusesInputSchema } from './dist/domain/electron/electronFuses.js';\nexport const inputSchemas = {\n  inspect_go_binary: z.toJSONSchema(inspectGoBinaryInputSchema, { io: 'input' }),\n  inspect_rust_binary: z.toJSONSchema(inspectRustBinaryInputSchema, { io: 'input' }),\n  inspect_pe_resources: z.toJSONSchema(inspectPeResourcesInputSchema, { io: 'input' }),\n  inspect_electron_fuses: z.toJSONSchema(inspectElectronFusesInputSchema, { io: 'input' }),\n};\nexport const createServices = () => ({\n  inspect_go_binary: new GoBinaryService(new GoBinaryProvider()),\n  inspect_rust_binary: new RustBinaryService(new RustBinaryProvider()),\n  inspect_pe_resources: new PeResourcesService(new PeResourcesProvider()),\n  inspect_electron_fuses: new ElectronFuseService(new ElectronFuseProvider()),\n});\n",
